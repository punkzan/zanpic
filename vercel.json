{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    { "source": "/blog/seed-1", "destination": "/blog/how-to-take-id-photo", "permanent": true },
    { "source": "/blog/seed-2", "destination": "/blog/ai-background-removal-isnet", "permanent": true },
    { "source": "/blog/seed-3", "destination": "/blog/ecommerce-product-background-removal", "permanent": true },
    { "source": "/blog/seed-4", "destination": "/blog/id-photo-background-color-guide", "permanent": true },
    { "source": "/blog/seed-5", "destination": "/blog/photo-filter-color-grading-guide", "permanent": true },
    { "source": "/blog/seed-6", "destination": "/blog/webgpu-ai-inference-acceleration", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
